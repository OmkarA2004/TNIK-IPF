; TNIK energy minimisation
integrator              = steep
emtol                   = 100.0
emstep                  = 0.01
nsteps                  = 50000

; Neighbour searching
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.0

; van der Waals
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = no

; Periodic boundary conditions
pbc                     = xyz

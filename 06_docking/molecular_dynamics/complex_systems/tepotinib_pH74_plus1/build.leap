
source leaprc.protein.ff14SB
source leaprc.phosaa14SB
source leaprc.gaff2
source leaprc.water.tip3p

loadamberparams frcmod.ionsjc_tip3p
loadamberparams /Users/omkardaravattu/Desktop/TNIK_IPF_Project/06_docking/molecular_dynamics/ligand_parameterization/pH74_GAFF2/tepotinib_pH74_plus1/tepotinib_pH74_plus1.frcmod

protein = loadpdb /Users/omkardaravattu/Desktop/TNIK_IPF_Project/06_docking/molecular_dynamics/structures/TNIK_6RA7_protein_raw.pdb
ligand = loadmol2 /Users/omkardaravattu/Desktop/TNIK_IPF_Project/06_docking/molecular_dynamics/ligand_parameterization/pH74_GAFF2/tepotinib_pH74_plus1/tepotinib_pH74_plus1.mol2

check protein
check ligand

complex = combine { protein ligand }

check complex
charge complex

solvatebox complex TIP3PBOX 12.0

# Neutralise the complex with chloride ions.
addIonsRand complex Cl- 0

check complex
charge complex

saveamberparm complex /Users/omkardaravattu/Desktop/TNIK_IPF_Project/06_docking/molecular_dynamics/complex_systems/tepotinib_pH74_plus1/complex.prmtop /Users/omkardaravattu/Desktop/TNIK_IPF_Project/06_docking/molecular_dynamics/complex_systems/tepotinib_pH74_plus1/complex.inpcrd
